{
  "name": "zignaneural-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-migrations.mjs",
    "start": "node --dns-result-order=ipv4first dist/index.js",
    "migrate": "node --dns-result-order=ipv4first dist/db/migrate.js",
    "migrate:prod": "node --dns-result-order=ipv4first dist/db/migrate.js",
    "migrate:dev": "node --dns-result-order=ipv4first --import tsx/esm src/db/migrate.ts",
    "clickhouse:migrate": "node --dns-result-order=ipv4first dist/analytics/clickhouse-migrate.js",
    "clickhouse:migrate:dev": "node --dns-result-order=ipv4first --import tsx/esm src/analytics/clickhouse-migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
