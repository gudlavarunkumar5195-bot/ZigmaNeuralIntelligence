# ZigmaNeural Server Environment Variables
# Copy to server/.env and fill in real values.
# NEVER commit server/.env — it contains secrets.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the application database
DATABASE_URL=postgresql://zignaneural:password@localhost:5432/zignaneural
# Set true only when the database CA chain is trusted by the runtime.
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA chain for managed PostgreSQL/Supabase.
# DB_SSL_CA=
# Optional direct (non-pooled) Neon connection string. Server-only.
# DIRECT_DATABASE_URL=
# Optional non-secret label shown in Administration > Infrastructure.
# NEON_BRANCH=production

# ─── ClickHouse Cloud (analytics/event store, optional) ───────────────────────
# HTTPS only, certificate verification always on. Never set
# NODE_TLS_REJECT_UNAUTHORIZED=0 to work around certificate errors; add the
# issuing CA to CLICKHOUSE_CA_CERT (PEM) only if your runtime does not trust it.
# CLICKHOUSE_HOST=your-service.ap-southeast-1.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
# CLICKHOUSE_DATABASE=zigmaneural_analytics
CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_CA_CERT=

# ─── Auth Secrets ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_char_random_secret

# Generate with: openssl rand -hex 32
COOKIE_SECRET=replace_with_at_least_32_char_random_secret

# QA verification bypass (server-only; keep disabled outside an isolated QA environment)
QA_VERIFICATION_BYPASS_ENABLED=false
QA_AUTHORIZED_EMAILS=
QA_ALLOW_PRODUCTION_BYPASS=false

# Platform administrators (comma-separated user UUIDs, NOT emails). Only these
# users may refresh the model catalog, enable/disable global models and agents,
# or change the global routing policy. Empty = nobody can (fail closed).
PLATFORM_ADMIN_USER_IDS=

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin (comma-separated for multiple)
CORS_ORIGIN=http://localhost:8443

# ─── Scanner Limits ────────────────────────────────────────────────────────────
SCANNER_CONNECT_TIMEOUT_MS=10000
SCANNER_RESPONSE_TIMEOUT_MS=30000
SCANNER_MAX_RESPONSE_BYTES=5242880
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_PAGES=200
SCANNER_MAX_SCAN_DURATION_MS=300000
MAX_CONCURRENT_SCANS_PER_TENANT=2
MAX_QUEUED_SCANS_PER_TENANT=10
MAX_SCAN_CREATIONS_PER_MINUTE=10

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=2000

# ─── OX Alpha / AI Orchestration ──────────────────────────────────────────────
# Required for AI analysis. Obtain from https://openrouter.ai
# SECURITY: Never put this in VITE_* variables — it is server-side only.
OPENROUTER_API_KEY=

# Default model used by OX Alpha (falls back to free model if absent)
OX_ALPHA_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Execution limits
OX_ALPHA_TIMEOUT_MS=60000
OX_ALPHA_MAX_RETRIES=3
OX_ALPHA_MAX_OUTPUT_TOKENS=4096
# Hard per-organization cap on AI model attempts per rolling 24h
AI_MAX_EXECUTIONS_PER_ORG_PER_DAY=500

# ─── Rules ────────────────────────────────────────────────────────────────────
# These variables are SERVER-ONLY. Never put them in VITE_* frontend variables.
# - DATABASE_URL contains database credentials
# - JWT_SECRET is a signing key
# - COOKIE_SECRET is an encryption key
# None of these should ever appear in the browser bundle.

# Reverse-proxy trust (rate limiting keys on request.ip).
# Unset/false (default): X-Forwarded-For is ignored; request.ip is the socket peer.
# Behind DigitalOcean App Platform use a hop count: TRUST_PROXY=1
# Or a comma-separated list of proxy IPs/CIDRs (also: loopback, linklocal, uniquelocal).
# "true" is rejected on purpose: it lets clients spoof their IP and dodge limits.
TRUST_PROXY=

# Scan crash recovery: a scan whose worker lease expires is requeued until this
# many execution attempts have been used, then failed.
SCAN_MAX_EXECUTION_ATTEMPTS=3
# Max time to wait for the in-flight scan on SIGTERM before it is requeued.
SHUTDOWN_GRACE_MS=20000

# Scan progress SSE stream caps (429 when exceeded) and DB poll interval (>=1500)
SSE_MAX_STREAMS_PER_USER=3
SSE_MAX_STREAMS_PER_ORG=10
SSE_MAX_STREAMS_GLOBAL=40
SSE_POLL_INTERVAL_MS=2000
