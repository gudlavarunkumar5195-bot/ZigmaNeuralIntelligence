# ZigmaNeural Server Environment Variables
# Copy to server/.env and fill in real values.
# NEVER commit server/.env — it contains secrets.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the application database
DATABASE_URL=postgresql://zignaneural:password@localhost:5432/zignaneural
# Set true only when the database CA chain is trusted by the runtime.
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA chain for managed PostgreSQL/Supabase.
# DB_SSL_CA=
# Optional direct (non-pooled) Neon connection string. Server-only.
# DIRECT_DATABASE_URL=
# Optional non-secret label shown in Administration > Infrastructure.
# NEON_BRANCH=production

# ─── ClickHouse Cloud (analytics/event store, optional) ───────────────────────
# HTTPS only, certificate verification always on. Never set
# NODE_TLS_REJECT_UNAUTHORIZED=0 to work around certificate errors; add the
# issuing CA to CLICKHOUSE_CA_CERT (PEM) only if your runtime does not trust it.
# CLICKHOUSE_HOST=your-service.ap-southeast-1.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
# CLICKHOUSE_DATABASE=zigmaneural_analytics
CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_CA_CERT=

# ─── Auth Secrets ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_char_random_secret

# Generate with: openssl rand -hex 32
COOKIE_SECRET=replace_with_at_least_32_char_random_secret

# QA verification bypass (server-only; keep disabled outside an isolated QA environment)
QA_VERIFICATION_BYPASS_ENABLED=false
QA_AUTHORIZED_EMAILS=
QA_ALLOW_PRODUCTION_BYPASS=false

# Platform administrators (comma-separated user UUIDs, NOT emails). Only these
# users may refresh the model catalog, enable/disable global models and agents,
# or change the global routing policy. Empty = nobody can (fail closed).
PLATFORM_ADMIN_USER_IDS=
# The only account Admin → Users & Access → Generate Login Credentials may create
# or reset (docs/ADMIN_CONTROL_CENTER.md).
ADMIN_CREDENTIAL_ACCOUNT_EMAIL=info@zigmaneural.com

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin (comma-separated for multiple)
CORS_ORIGIN=http://localhost:8443

# ─── Scanner Limits ────────────────────────────────────────────────────────────
SCANNER_CONNECT_TIMEOUT_MS=10000
SCANNER_RESPONSE_TIMEOUT_MS=30000
SCANNER_MAX_RESPONSE_BYTES=5242880
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_PAGES=200
SCANNER_MAX_SCAN_DURATION_MS=300000
# Multi-page technical crawl budget per scan (pages capped by SCANNER_MAX_PAGES)
SCANNER_CRAWL_MAX_PAGES=100
SCANNER_CRAWL_MAX_DURATION_MS=120000
# Link depth from the start URL, parallel requests, per-request body timeout and
# per-page HTML size cap. Users can lower these per scan, never raise them.
SCANNER_CRAWL_MAX_DEPTH=5
SCANNER_CRAWL_CONCURRENCY=2
SCANNER_CRAWL_REQUEST_TIMEOUT_MS=15000
SCANNER_CRAWL_MAX_PAGE_BYTES=2097152
MAX_CONCURRENT_SCANS_PER_TENANT=2
MAX_QUEUED_SCANS_PER_TENANT=10
MAX_SCAN_CREATIONS_PER_MINUTE=10

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=2000

# ─── OX Alpha / AI Orchestration ──────────────────────────────────────────────
# Required for AI analysis. Obtain from https://openrouter.ai
# SECURITY: Never put this in VITE_* variables — it is server-side only.
# Optional fallback: an administrator can store and validate the key in
# Admin → Integrations & API Keys (encrypted with INTEGRATION_ENCRYPTION_KEYS);
# a stored key takes precedence.
OPENROUTER_API_KEY=

# Default model used by OX Alpha (falls back to free model if absent)
OX_ALPHA_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Execution limits
OX_ALPHA_TIMEOUT_MS=60000
OX_ALPHA_MAX_RETRIES=3
OX_ALPHA_MAX_OUTPUT_TOKENS=4096
# Hard per-organization cap on AI model attempts per rolling 24h
AI_MAX_EXECUTIONS_PER_ORG_PER_DAY=500
# Paid models are disabled until pricing and spend limits are verified. While
# false only registry-verified FREE models are called. Needs explicit approval.
AI_ALLOW_PAID_MODELS=false
# Optional extra LLM call that advises on model routing (off: deterministic).
AI_ROUTER_LLM_ENABLED=false

# ─── Google Search Console (optional; see docs/SEARCH_CONSOLE.md) ───────────
# Without these the integration reports "not configured" and calls nothing.
# Production refuses a partial setup, a non-https redirect URI, or a missing key.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an authorized redirect URI of the OAuth client.
# GOOGLE_OAUTH_REDIRECT_URI=https://app.example.com/api/v1/integrations/google/oauth/callback
# Where the browser returns after OAuth (defaults to the first CORS_ORIGIN).
# APP_PUBLIC_URL=https://app.example.com
# AES-256-GCM keys for stored refresh tokens: "k1:<base64 of 32 random bytes>".
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# INTEGRATION_ENCRYPTION_KEYS=
# INTEGRATION_ENCRYPTION_ACTIVE_KEY_ID=
GSC_SYNC_INTERVAL_MINUTES=1440
GSC_INITIAL_LOOKBACK_DAYS=90
GSC_REVISIT_DAYS=5
GSC_MAX_REQUESTS_PER_MINUTE=60
GSC_DATA_RETENTION_DAYS=490
GSC_REQUEST_TIMEOUT_MS=30000

# ─── Keyword research (Phase 4, docs/KEYWORD_RESEARCH.md) ─────────────────────
# Enabled providers. Only google_search_console (first-party, uses the synced
# Search Console data, no per-request cost) is implemented. Licensed providers
# are paid and need owner approval before they are added.
KEYWORD_RESEARCH_PROVIDERS=google_search_console
KEYWORD_RESEARCH_MAX_RUNS_PER_ORG_PER_DAY=200
KEYWORD_RESEARCH_MAX_RESULTS=500
KEYWORD_RESEARCH_RETENTION_DAYS=400
KEYWORD_RESEARCH_PROVIDER_TIMEOUT_MS=30000

# ─── Backlink intelligence (Phase 5, docs/BACKLINKS.md) ───────────────────────
# Data comes from authorized CSV imports and our own live link checks; no
# licensed backlink provider is integrated (paid; needs approval).
BACKLINK_IMPORT_MAX_ROWS=50000
BACKLINK_IMPORT_MAX_BYTES=10000000
BACKLINK_STALE_DAYS=30
BACKLINK_VERIFY_MAX_LINKS=200
BACKLINK_VERIFY_CONCURRENCY=4

# ─── Content intelligence (Phase 7, docs/CONTENT_INTELLIGENCE.md) ─────────────
# Heuristic thresholds (labelled as heuristics in findings) and the analysis bound.
CONTENT_THIN_WORDS=200
CONTENT_STALE_MONTHS=24
CONTENT_MAX_PAGES=5000

# ─── Rank tracking (Phase 6, docs/RANK_TRACKING.md) ───────────────────────────
# Rankings come from authorized ranking-report imports; no SERP provider is
# integrated (paid; needs approval). Quotas apply once one is configured.
RANK_MAX_KEYWORDS_PER_PROJECT=500
RANK_MAX_COMPETITORS=10
RANK_MAX_REQUESTS_PER_ORG_PER_DAY=1000
RANK_IMPORT_MAX_ROWS=50000
RANK_IMPORT_MAX_BYTES=10000000
RANK_PROVIDER_CONCURRENCY=2

# ─── Rules ────────────────────────────────────────────────────────────────────
# These variables are SERVER-ONLY. Never put them in VITE_* frontend variables.
# - DATABASE_URL contains database credentials
# - JWT_SECRET is a signing key
# - COOKIE_SECRET is an encryption key
# None of these should ever appear in the browser bundle.

# Reverse-proxy trust (rate limiting keys on request.ip).
# Unset/false (default): X-Forwarded-For is ignored; request.ip is the socket peer.
# Behind DigitalOcean App Platform use a hop count: TRUST_PROXY=1
# Or a comma-separated list of proxy IPs/CIDRs (also: loopback, linklocal, uniquelocal).
# "true" is rejected on purpose: it lets clients spoof their IP and dodge limits.
TRUST_PROXY=

# Scan crash recovery: a scan whose worker lease expires is requeued until this
# many execution attempts have been used, then failed.
SCAN_MAX_EXECUTION_ATTEMPTS=3
# Max time to wait for the in-flight scan on SIGTERM before it is requeued.
SHUTDOWN_GRACE_MS=20000

# Scan progress SSE stream caps (429 when exceeded) and DB poll interval (>=1500)
SSE_MAX_STREAMS_PER_USER=3
SSE_MAX_STREAMS_PER_ORG=10
SSE_MAX_STREAMS_GLOBAL=40
SSE_POLL_INTERVAL_MS=2000
